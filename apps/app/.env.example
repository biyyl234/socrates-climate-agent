# Public client config (safe to expose). Copy to .env and fill as needed.
# Leave blank to run fully offline: built-in demo script + local factor library + L4 text avatar.

# Supabase project URL used as the backend base.
EXPO_PUBLIC_SUPABASE_URL=
# Public anon / publishable key attached to backend requests.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Standalone avatar bundle URL (iframe on web, WebView on native).
EXPO_PUBLIC_AVATAR_URL=
# Locale hint sent to the avatar and backend.
EXPO_PUBLIC_LOCALE=zh-CN
