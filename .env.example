# Non-secret template. Copy to .env and fill values. .env is never committed.
# Secrets only live in Supabase edge-function secrets + local .env; the client
# bundle never contains any of these.

# Expo / EAS
EXPO_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PERSONAL_TOKEN=
SUPABASE_DB_PASSWORD=

# Vercel
VERCEL_TOKEN=

# LLM (OpenAI-compatible: DeepSeek / OpenAI / Volcano Ark). Provided later.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# TTS — Volcano Engine (火山引擎). Credentials provided later; adapter first.
TTS_PROVIDER=volcano
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=
VOLC_TTS_VOICE_TYPE=

# Public client config (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
