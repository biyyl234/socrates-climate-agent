{
  "name": "socrates-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Socrates — Campus Living Lab carbon literacy agent (ATOX AI for Climate, P39)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter=./packages/* test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "app": "pnpm --filter @socrates/app",
    "avatar": "pnpm --filter @socrates/avatar",
    "functions": "pnpm --filter @socrates/supabase"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
